    <model name="front_camera">
      <static>true</static>
      <link name="camera_link">
        <pose>1.06 -0.90 0.66 0 0.34 2.42</pose>
        <sensor name="front" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/camera/front/image_raw</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>.01</near>
              <far>5</far>
            </clip>
          </camera>
        </sensor>
