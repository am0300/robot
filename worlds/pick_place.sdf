      <joint name="shoulder_pan" type="revolute">
        <pose relative_to="__model__">0 0 .17 0 0 0</pose>
        <parent>base</parent>
        <child>pan</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-2.0</lower>
            <upper>2.0</upper>
            <effort>15</effort>
          </limit>
          <dynamics>
            <damping>0.3</damping>
          </dynamics>
        </axis>
      </joint>
      <joint name="shoulder_lift" type="revolute">
        <pose relative_to="__model__">0 0 .24 0 0 0</pose>
        <parent>pan</parent>
        <child>upper_arm</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.4</lower>
            <upper>1.4</upper>
            <effort>15</effort>
          </limit>
          <dynamics>
            <damping>0.3</damping>
          </dynamics>
        </axis>
      </joint>
      <joint name="elbow_flex" type="revolute">
        <pose relative_to="__model__">.23 0 .24 0 0 0</pose>
        <parent>upper_arm</parent>
        <child>forearm</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.9</lower>
            <upper>1.9</upper>
            <effort>15</effort>
          </limit>
          <dynamics>
            <damping>0.3</damping>
