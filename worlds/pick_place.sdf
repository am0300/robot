        <child>wrist_flex_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.5</lower>
            <upper>1.5</upper>
            <effort>15</effort>
          </limit>
          <dynamics>
            <damping>0.3</damping>
          </dynamics>
        </axis>
      </joint>
      <joint name="wrist_roll" type="revolute">
        <pose relative_to="__model__">.55 0 .24 0 0 0</pose>
        <parent>wrist_flex_link</parent>
        <child>wrist_roll_link</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-2.3</lower>
            <upper>2.3</upper>
            <effort>15</effort>
          </limit>
          <dynamics>
            <damping>0.3</damping>
          </dynamics>
        </axis>
      </joint>
      <joint name="finger_fixed" type="fixed">
        <parent>wrist_roll_link</parent>
        <child>fixed_finger</child>
      </joint>
      <joint name="gripper" type="prismatic">
        <pose relative_to="__model__">.64 .028 .24 0 0 0</pose>
        <parent>wrist_roll_link</parent>
        <child>moving_finger</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-.035</lower>
            <upper>0.0</upper>
            <effort>30</effort>
          </limit>
        </axis>
      </joint>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>shoulder_pan</joint_name>
        <topic>/arm/cmd/shoulder_pan</topic>
        <p_gain>25</p_gain>
        <i_gain>0</i_gain>
        <d_gain>1</d_gain>
        <cmd_max>30</cmd_max>
        <cmd_min>-30</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
